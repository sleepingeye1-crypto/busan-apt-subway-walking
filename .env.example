# .env에 넣을 키 이름 목록 (값은 비워 둠 — 실제 값은 .env에만 적는다)

# 카카오맵 JavaScript 키 (지도 표시용, 브라우저에서 쓰므로 NEXT_PUBLIC_ 붙임)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# 카카오 REST API 키 (장소·주소 검색용, 서버에서만 사용)
KAKAO_REST_API_KEY=

# 공공데이터포털 일반 인증키 (공동주택 단지 정보용)
DATA_GO_KR_SERVICE_KEY=

# Supabase 접속 주소 (DB 저장소)
SUPABASE_URL=

# Supabase 읽기용 키 (anon, 화면에서 DB를 읽을 때 서버에서만 사용)
SUPABASE_ANON_KEY=

# Supabase 쓰기용 키 (service_role, 수집 스크립트 전용. 화면 코드에서는 절대 쓰지 않음)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase 관리용 토큰 (표 만들기·CLI 전용, 내 컴퓨터에서만 사용. 배포 환경에 올리지 않음)
SUPABASE_ACCESS_TOKEN=

# Vercel 배포용 토큰 (배포 CLI 전용, 내 컴퓨터에서만 사용. 배포 환경에 올리지 않음)
VERCEL_TOKEN=
GITHUB_TOKEN=
